# This parameter file generates a weak non-rotating l=0 seed.

# GRID
dr          = 6.25000E-02
dz          = 6.25000E-02
NrInterior  = 256
NzInterior  = 256
order       = 4

# INITIAL DATA
readInitialData = 0

# SCALAR FIELD PROPERTIES
l       = 0
m       = 1.0
psi0    = 0.01
sigmaR  = 4.0
sigmaZ  = 4.0
rExt    = 12.0

# INITIAL FREQUENCY
w0      = 9.50000E-01

# FIXED VARIABLE
fixedPhi   = 0
fixedPhiR  = 0
fixedPhiZ  = 0
fixedOmega = 1

# SOLVER PARAMETERS
solverType      = 1
localSolver     = 1
epsilon         = 1.0E-8
maxNewtonIter   = 20
lambda0         = 1.0E-03
lambdaMin       = 1.0E-05
useLowRank      = 0

# NEXT SOLUTION
sweep = 0

# BOUNDARY TYPES
alphaBoundOrder = 1;
betaBoundOrder  = 1;
hBoundOrder     = 1;
aBoundOrder     = 1;
phiBoundOrder   = 1;
